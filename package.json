{
  "name": "yt-converter",
  "version": "1.0.0",
  "description": "Minimal YouTube to MP3/MP4 converter",
  "type": "module",
  "scripts": {
    "service-worker:sync": "node scripts/sync-service-worker-assets.mjs",
    "start": "npm run service-worker:sync && tsx watch server/index.ts",
    "dev": "npm run service-worker:sync && tsx watch server/index.ts",
    "test": "npm run service-worker:sync && vitest run",
    "test:watch": "npm run service-worker:sync && vitest",
    "build": "npm run service-worker:sync && tsc",
    "docker:build": "docker build -t yt-converter:local .",
    "docker:test": "npm run docker:build && docker run --rm -p 3000:3000 yt-converter:local",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "preflight": "npm test && npm run build && npm run docker:build"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "express": "^4.20.0",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bull": "^3.15.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/supertest": "^7.2.0",
    "jsdom": "^29.0.1",
    "nodemon": "^3.1.11",
    "semver": "^7.7.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  }
}
